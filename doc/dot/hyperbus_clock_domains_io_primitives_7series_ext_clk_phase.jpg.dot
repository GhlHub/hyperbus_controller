digraph hyperbus_clock_domains_io_primitives_7series_ext_clk_phase {
  graph [
    rankdir=LR,
    splines=ortho,
    nodesep=0.5,
    ranksep=0.8,
    pad=0.25,
    bgcolor="white",
    label="Clock Domains and IO Primitive Relationships\nPHY_FAMILY_7SERIES, PHY_IO_STYLE_EXT_CLK_PHASE_SHIFT",
    labelloc=t,
    fontsize=22,
    fontname="Helvetica-Bold"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=12,
    color="#3A3A3A",
    penwidth=1.2,
    margin="0.14,0.09"
  ];

  edge [
    color="#4A4A4A",
    penwidth=1.4,
    arrowsize=0.8,
    fontname="Helvetica",
    fontsize=10
  ];

  subgraph cluster_axi {
    label="AXI / Software Domain: i_axi_aclk";
    color="#5B8DEF";
    penwidth=1.5;
    style="rounded";

    axi_frontends [label="AXI4-Full + AXI4-Lite front ends\nsoftware-visible registers\nread/write request formation", fillcolor="#DCEBFF"];
    delay_regs [label="delay-control registers exist\nbut are unused in ext-clock mode\nstatus reads return bypass values", fillcolor="#C8DDFF"];
  }

  subgraph cluster_cdc {
    label="Async FIFO Boundary";
    color="#7A6FD6";
    penwidth=1.5;
    style="rounded";

    cdc_cmd_wr [label="AXI -> HB\ncmd_fifo, wr_fifo", fillcolor="#E4DFFF"];
    cdc_rd_rsp [label="HB -> AXI\nrd_fifo, axil_rsp_fifo", fillcolor="#E4DFFF"];
  }

  subgraph cluster_hb {
    label="HyperBus Fabric Domain: i_hb_clk_200";
    color="#2E9D6F";
    penwidth=1.5;
    style="rounded";

    hb_fsm [label="u_hb_engine\ntransaction state machine\nCS# timing, latency count\nread/write packing", fillcolor="#DDF3E9"];
    tx_launch_regs [label="fabric launch registers\nDQ/RWDS D1/D2 data\nDQ/RWDS tri-state\nCS# and CK enable", fillcolor="#C9EBD9"];
    rx_stage [label="read-side alignment in HB engine\nregistered DQ/RWDS q1/q2\nRWDS-qualified beat acceptance", fillcolor="#C9EBD9"];
  }

  subgraph cluster_ck_forward {
    label="Forwarded CK Domain: i_hb_clk_200_gated";
    color="#F0A14A";
    penwidth=1.5;
    style="rounded";

    ck_gate [label="clock enable control\nhb_clk_ce / force enable", fillcolor="#FFE6CC"];
    ck_oddr [label="u_oddr_ck\n7-series ODDR\nC = i_hb_clk_200_gated\nD1=1, D2=0", fillcolor="#FFD7A8"];
    ck_pad [label="o_hb_ck_p pad\nsingle-ended forwarded CK\no_hb_ck_n held low", fillcolor="#FFC987"];
  }

  subgraph cluster_tx_prims {
    label="DQ/RWDS TX IO Primitives: launched by i_hb_clk_200";
    color="#2E9D6F";
    penwidth=1.5;
    style="rounded,dashed";

    dq_oddr [label="g_dq_phy[n].u_oddr_dq\n7-series ODDR\nC = i_hb_clk_200\nD1/D2 = byte DDR data", fillcolor="#DDF3E9"];
    dq_iobuf [label="g_dq_phy[n].u_iobuf_dq\nIOBUF\nT = i_dq_t[n]", fillcolor="#C9EBD9"];
    rwds_oddr [label="u_oddr_rwds\n7-series ODDR\nC = i_hb_clk_200\nD1/D2 = RWDS mask/data", fillcolor="#DDF3E9"];
    rwds_iobuf [label="u_iobuf_rwds\nIOBUF\nT = i_rwds_t", fillcolor="#C9EBD9"];
  }

  subgraph cluster_rx_sample {
    label="DQ/RWDS RX Sample Domain: i_hb_clk_200_samp_90";
    color="#C46BCB";
    penwidth=1.5;
    style="rounded";

    dq_iddr [label="g_dq_phy[n].u_iddr_dq\n7-series IDDR\nC = i_hb_clk_200_samp_90\ncaptures DQ q1/q2", fillcolor="#F0D8F4"];
    rwds_iddr [label="u_iddr_rwds\n7-series IDDR\nC = i_hb_clk_200_samp_90\ncaptures RWDS q1/q2", fillcolor="#F0D8F4"];
    iddr_rst [label="i_iddre1_rst\nreset synchronous to sample clock", fillcolor="#E8C5EE"];
  }

  subgraph cluster_ext_mode {
    label="External Phase-Shift Mode";
    color="#9E9E9E";
    penwidth=1.3;
    style="rounded,dashed";

    bypass [label="g_ext_clk_phase_shift\nhb_ck_fwd = hb_ck_pre_odly\ndq_i_delayed = dq_i\nrwds_i_delayed = rwds_i", fillcolor="#EFEFEF"];
    no_delay [label="No IDELAYE2 / ODELAYE2 path active\nIDELAYCTRL not required by selected branch\ncntvalue outputs = 0\nready reported high", fillcolor="#EFEFEF"];
  }

  hb_pins [label="HyperBus pins\nCK, CS#, DQ[7:0], RWDS, RESET#", fillcolor="#FFE0C2"];

  axi_frontends -> cdc_cmd_wr [label="requests"];
  delay_regs -> bypass [style=dashed, color="#8A8A8A", label="unused controls"];
  cdc_cmd_wr -> hb_fsm [label="HB cmds/write data"];
  hb_fsm -> cdc_rd_rsp [label="read/rsp data"];
  cdc_rd_rsp -> axi_frontends [label="AXI returns"];

  hb_fsm -> tx_launch_regs [label="registered outputs"];
  tx_launch_regs -> dq_oddr [label="DQ D1/D2"];
  tx_launch_regs -> rwds_oddr [label="RWDS D1/D2"];
  tx_launch_regs -> dq_iobuf [label="DQ T"];
  tx_launch_regs -> rwds_iobuf [label="RWDS T"];
  hb_fsm -> ck_gate [label="hb_clk_ce"];
  ck_gate -> ck_oddr [style=dashed, label="enables gated clock upstream"];

  ck_oddr -> bypass [label="hb_ck_pre_odly"];
  bypass -> ck_pad [label="hb_ck_fwd"];
  ck_pad -> hb_pins [label="CK"];

  dq_oddr -> dq_iobuf [label="O"];
  rwds_oddr -> rwds_iobuf [label="O"];
  dq_iobuf -> hb_pins [label="DQ drive"];
  rwds_iobuf -> hb_pins [label="RWDS drive"];

  hb_pins -> dq_iobuf [label="DQ input"];
  hb_pins -> rwds_iobuf [label="RWDS input"];
  dq_iobuf -> bypass [label="dq_i"];
  rwds_iobuf -> bypass [label="rwds_i"];
  bypass -> dq_iddr [label="dq_i_delayed = dq_i"];
  bypass -> rwds_iddr [label="rwds_i_delayed = rwds_i"];
  iddr_rst -> dq_iddr [style=dashed, label="reset"];
  iddr_rst -> rwds_iddr [style=dashed, label="reset"];
  dq_iddr -> rx_stage [label="dq_q1/q2"];
  rwds_iddr -> rx_stage [label="rwds_q1/q2"];
  rx_stage -> hb_fsm [label="captured read beats"];

  no_delay -> bypass [style=dashed, arrowhead=none];

  note [shape=note, fillcolor="#FFF8CC", label="Clock relationship summary:\n- AXI domain communicates with HB domain only through async FIFOs.\n- HB fabric uses i_hb_clk_200 for engine logic and DQ/RWDS DDR launch.\n- Forwarded CK uses a separate gated 200 MHz clock into the CK ODDR.\n- Read capture uses the external +90 degree sample clock into DQ/RWDS IDDRs.\n- In ext-clock phase-shift mode, phase tuning is outside this PHY branch, not IDELAY/ODELAY based."];
  no_delay -> note [style=dashed, arrowhead=none];
}
